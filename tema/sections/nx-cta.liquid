<style>
  .nx-cta{background:#242632;color:#f5f7fa;position:relative;overflow:hidden}
  .nx-cta::after{content:"";position:absolute;right:-10%;top:-40%;width:50vw;height:50vw;max-width:700px;max-height:700px;border-radius:50%;background:radial-gradient(closest-side,rgba(118,94,190,.35),transparent 70%)}
  .nx-cta__in{position:relative;z-index:1;max-width:1200px;margin:0 auto;padding:64px 24px;display:flex;justify-content:space-between;align-items:center;gap:32px;flex-wrap:wrap}
  .nx-cta h2{font:800 clamp(1.6rem,3vw,2.3rem)/1.15 var(--font-heading--family,inherit);margin:0 0 8px;color:#fff}
  .nx-cta p{color:#c9cfdb;margin:0;max-width:56ch}
  @media(max-width:700px){.nx-cta__in{padding:48px 20px}}
</style>
<section class="nx-cta"><div class="nx-cta__in">
  <div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>
  <div class="nx-btns"><a class="nx-btn nx-btn--p" href="{{ section.settings.btn1_url }}" target="_blank" rel="noopener">{{ section.settings.btn1 }}</a><a class="nx-btn nx-btn--s" href="{{ section.settings.btn2_url }}">{{ section.settings.btn2 }}</a></div>
</div></section>
{% schema %}
{
  "name": "NX Çağrı",
  "settings": [
    {"type": "text", "id": "heading", "label": "Başlık", "default": "Hangi paket size uygun, emin değil misiniz?"},
    {"type": "textarea", "id": "text", "label": "Metin", "default": "10 dakikalık ücretsiz ön görüşmede ihtiyacınızı dinleyip doğru paketi birlikte seçelim."},
    {"type": "text", "id": "btn1", "label": "Buton 1", "default": "WhatsApp’tan yazın"},
    {"type": "text", "id": "btn1_url", "label": "Bağlantı 1", "default": "https://wa.me/905527096900?text=Merhaba%2C%20bir%20paket%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum."},
    {"type": "text", "id": "btn2", "label": "Buton 2", "default": "Hemen arayın: 0552 709 69 00"},
    {"type": "text", "id": "btn2_url", "label": "Bağlantı 2", "default": "tel:+905527096900"}
  ],
  "presets": [{"name": "NX Çağrı"}]
}
{% endschema %}
