{%- comment -%} Nextosoft hero: metin + görsel {%- endcomment -%}
<style>
  .nx-kicker{display:inline-flex;align-items:center;gap:8px;font:600 .8rem/1 var(--font-subheading--family,inherit);letter-spacing:.08em;text-transform:uppercase;color:#9fc6ea;background:rgba(71,142,204,.14);border:1px solid rgba(71,142,204,.35);padding:8px 14px;border-radius:999px;margin-bottom:22px}
  .nx-btns{display:flex;gap:12px;flex-wrap:wrap}
  .nx-btn{display:inline-flex;align-items:center;gap:8px;padding:14px 22px;border-radius:10px;font-weight:700;text-decoration:none;transition:.2s}
  .nx-btn--p{background:#478ecc;color:#fff}.nx-btn--p:hover{background:#3a7bb4;color:#fff}
  .nx-btn--s{background:rgba(255,255,255,.06);color:#f5f7fa;border:1px solid rgba(255,255,255,.22)}.nx-btn--s:hover{background:rgba(255,255,255,.12);color:#fff}
  .nx-h2{font:800 clamp(1.7rem,3vw,2.4rem)/1.15 var(--font-heading--family,inherit);color:#20212d;letter-spacing:-.02em;margin:0 0 10px}
  .nx-sub{color:#697080;max-width:60ch;margin:0 0 36px;font-size:1.05rem;line-height:1.6}
  .nx-hero{background:#2d2e3d;color:#f5f7fa;position:relative;overflow:hidden}
  .nx-hero::before{content:"";position:absolute;inset:-20% -10% auto auto;width:60vw;height:60vw;max-width:900px;max-height:900px;border-radius:50%;background:radial-gradient(closest-side,rgba(71,142,204,.35),rgba(118,94,190,.18) 55%,transparent 72%);pointer-events:none}
  .nx-hero__in{position:relative;max-width:1200px;margin:0 auto;padding:88px 24px 72px;display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center}
  .nx-hero h1{font:800 clamp(2.2rem,4.6vw,3.8rem)/1.08 var(--font-heading--family,inherit);margin:0 0 18px;letter-spacing:-.02em;color:#fff}
  .nx-hero p{font-size:1.1rem;line-height:1.65;color:#c9cfdb;max-width:52ch;margin:0 0 30px}
  .nx-hero__pts{display:flex;gap:22px;flex-wrap:wrap;margin:30px 0 0;padding:0;list-style:none;color:#c9cfdb;font-size:.92rem}
  .nx-hero__pts li::before{content:"✓";color:#8fc1ec;margin-right:8px;font-weight:700}
  .nx-hero__img{position:relative}
  .nx-hero__img img{width:100%;height:auto;border-radius:20px;box-shadow:0 30px 80px rgba(0,0,0,.45);display:block}
  .nx-card{position:absolute;left:-18px;bottom:28px;background:#fff;color:#20212d;border-radius:14px;padding:14px 18px;box-shadow:0 20px 50px rgba(0,0,0,.35);font-size:.9rem}
  .nx-card b{display:block;font-size:1.25rem;color:#2d2e3d}
  @media(max-width:900px){.nx-hero__in{grid-template-columns:1fr;padding:56px 20px 48px}.nx-card{left:8px}}
</style>
<section class="nx-hero">
  <div class="nx-hero__in">
    <div>
      <span class="nx-kicker">{{ section.settings.kicker }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      <div class="nx-btns">
        <a class="nx-btn nx-btn--p" href="{{ section.settings.btn1_url }}">{{ section.settings.btn1 }}</a>
        <a class="nx-btn nx-btn--s" href="{{ section.settings.btn2_url }}" target="_blank" rel="noopener">{{ section.settings.btn2 }}</a>
      </div>
      <ul class="nx-hero__pts">
        <li>{{ section.settings.pt1 }}</li><li>{{ section.settings.pt2 }}</li><li>{{ section.settings.pt3 }}</li>
      </ul>
    </div>
    <div class="nx-hero__img">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager' }}
      {%- else -%}
        <img src="{{ section.settings.asset | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1600" height="800" loading="eager">
      {%- endif -%}
      <div class="nx-card">{{ section.settings.card_small }}<b>{{ section.settings.card_big }}</b></div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "NX Hero",
  "settings": [
    {"type": "text", "id": "kicker", "label": "Üst etiket", "default": "Nextosoft Dijital Hizmetler"},
    {"type": "text", "id": "heading", "label": "Başlık", "default": "İşinizi büyütecek paketi bugün başlatın."},
    {"type": "textarea", "id": "text", "label": "Metin", "default": "Net kapsam, başlangıç fiyatı ve teslim süresiyle hazırlanmış 10 profesyonel hizmet. Siparişinizi oluşturun, süreci tek numarayla takip edin."},
    {"type": "text", "id": "btn1", "label": "Buton 1", "default": "Paketleri inceleyin"},
    {"type": "text", "id": "btn1_url", "label": "Buton 1 bağlantı", "default": "/collections/all"},
    {"type": "text", "id": "btn2", "label": "Buton 2", "default": "WhatsApp’tan yazın"},
    {"type": "text", "id": "btn2_url", "label": "Buton 2 bağlantı", "default": "https://wa.me/905527096900"},
    {"type": "text", "id": "pt1", "label": "Madde 1", "default": "Güvenli sipariş kaydı"},
    {"type": "text", "id": "pt2", "label": "Madde 2", "default": "Canlı durum takibi"},
    {"type": "text", "id": "pt3", "label": "Madde 3", "default": "KDV dahil net fiyat"},
    {"type": "image_picker", "id": "image", "label": "Görsel"},
    {"type": "text", "id": "asset", "label": "Varsayılan görsel (asset)", "default": "nx-story-software.webp"},
    {"type": "text", "id": "card_small", "label": "Kart küçük metin", "default": "Kurumsal web sitesi"},
    {"type": "text", "id": "card_big", "label": "Kart büyük metin", "default": "3–5 haftada teslim"}
  ],
  "presets": [{"name": "NX Hero"}]
}
{% endschema %}
