<style>
  .nx-steps{max-width:1200px;margin:0 auto;padding:64px 24px}
  .nx-steps__g{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .nx-step{position:relative;border:1px solid #e4e8ee;border-radius:16px;padding:28px 24px 24px;background:#fff;transition:.2s}
  .nx-step:hover{box-shadow:0 18px 40px rgba(45,46,61,.08);transform:translateY(-2px)}
  .nx-step i{display:inline-grid;place-items:center;width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#478ecc,#765ebe);color:#fff;font:800 1.1rem var(--font-heading--family,inherit);font-style:normal;margin-bottom:16px}
  .nx-step h3{font:700 1.15rem/1.3 var(--font-heading--family,inherit);color:#20212d;margin:0 0 8px}
  .nx-step p{color:#697080;margin:0;line-height:1.6}
  @media(max-width:900px){.nx-steps__g{grid-template-columns:1fr}}
</style>
<section class="nx-steps">
  <h2 class="nx-h2">{{ section.settings.heading }}</h2>
  <p class="nx-sub">{{ section.settings.text }}</p>
  <div class="nx-steps__g">
    {% for b in section.blocks %}<div class="nx-step" {{ b.shopify_attributes }}><i>{{ forloop.index }}</i><h3>{{ b.settings.title }}</h3><p>{{ b.settings.text }}</p></div>{% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "NX Nasıl çalışır",
  "settings": [
    {"type": "text", "id": "heading", "label": "Başlık", "default": "Üç adımda başlıyoruz"},
    {"type": "textarea", "id": "text", "label": "Metin", "default": "Paketi seçin, kısa bir keşif görüşmesiyle kapsamı netleştirelim, üretim ve teslimatı tek sipariş numarasından takip edin."}
  ],
  "blocks": [{"type": "step", "name": "Adım", "settings": [
    {"type": "text", "id": "title", "label": "Başlık"},
    {"type": "textarea", "id": "text", "label": "Metin"}
  ]}],
  "presets": [{"name": "NX Nasıl çalışır", "blocks": [
    {"type": "step", "settings": {"title": "Paketinizi seçin", "text": "Fiyatı, kapsamı ve teslim süresi belli 10 paketten ihtiyacınıza uyanı sepete ekleyin, güvenli ödeme yapın."}},
    {"type": "step", "settings": {"title": "Keşif görüşmesi", "text": "24 saat içinde sizi arıyoruz. Hedefleri, içerikleri ve istisnaları birlikte netleştirip üretim planını onaylıyoruz."}},
    {"type": "step", "settings": {"title": "Üretim ve teslimat", "text": "Sipariş numaranızla süreci canlı takip edin. Teslimat sonrası kapsam dahilindeki revizyonlar plana dahil."}}
  ]}]
}
{% endschema %}
